<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="700.0" spacing="16" style="-fx-padding: 40;" stylesheets="@magic.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="planner.ui.LoginController">

    <Label styleClass="title" alignment="CENTER" contentDisplay="CENTER" style="-fx-padding: 20;" text="Login" />

    <TextField fx:id="usernameField" maxWidth="450" promptText="Username">
      <font>
         <Font size="16.0" />
      </font></TextField>
    <PasswordField fx:id="passwordField" maxWidth="450" promptText="Password">
      <font>
         <Font size="16.0" />
      </font></PasswordField>
   <Hyperlink alignment="CENTER" onAction="#forgotPassword" text="Forgot password ?" />

    <Label fx:id="statusLabel" textFill="red" />
   <Button mnemonicParsing="false" onAction="#onRegister" minWidth="120" text="Register" />

    <Button onAction="#onLogin" minWidth="120" text="Login" />
</VBox>
